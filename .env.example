DATABASE_URL="postgresql://postgres:password@localhost:5432/kdexpress"
JWT_SECRET="un-secret-aleatoire-de-64-caracteres"
JWT_DUREE_SECONDES=86400
# Dossier où sont rangées les photos envoyées (exclu de Git)
DOSSIER_FICHIERS="fichiers"

# --- Mise en ligne (facultatif sur ton ordinateur) ---
# Sites web autorisés à appeler l'API depuis un navigateur, séparés par des virgules.
# Obligatoire quand NODE_ENV=production.
# ORIGINES_AUTORISEES="https://app.kdexpress.cd,https://admin.kdexpress.cd"
# Nombre de proxys de l'hébergeur placés devant l'API (souvent 1). 0 sur ton ordinateur.
# PROXYS_DE_CONFIANCE=1

# --- E-mails (mot de passe oublié, notifications de commande) ---
# Sans SMTP_URL, les e-mails sont seulement écrits dans le journal de l'API (pratique sur ton ordinateur).
# Obligatoires quand NODE_ENV=production.
# SMTP_URL="smtps://identifiant:motdepasse@smtp.exemple.com:465"
# EMAIL_EXPEDITEUR="KDExpress <contact@kdexpress.cd>"
# Toutes les combien de secondes l'API cherche des e-mails à envoyer (30 par défaut, 0 pour désactiver)
# NOTIFICATIONS_INTERVALLE_SECONDES=30
